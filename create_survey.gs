function createDriverSurvey() {
  var form = FormApp.create('Анонімне опитування водіїв DriveMe');

  form.setDescription(
    'Привіт!\n\n' +
    'Ми об\'єднали бренди DriveMe та WayUp Drive в єдину мережу. Тепер це одна команда — з єдиними стандартами, єдиними цінностями і єдиною метою: щоб кожен наш водій був почутий і заробляв у комфортних умовах.\n\n' +
    'Ваші відповіді повністю анонімні — ми не збираємо імена, номери телефонів чи будь-які дані які можуть вас ідентифікувати. Результати побачить лише центральне керівництво мережі — не директор вашого філіалу.\n\n' +
    'Опитування займе 3–5 хвилин. Дякуємо що знаходите час!'
  );

  form.setIsQuiz(false);
  form.setCollectEmail(false);
  form.setLimitOneResponsePerUser(false);
  form.setAllowResponseEdits(false);
  form.setConfirmationMessage('Дякуємо за вашу чесність! Ваші відповіді допоможуть нам стати кращими для кожного водія.\n\n— Центральне керівництво DriveMe');

  // ─────────────────────────────────────────────
  // БЛОК 1 — Загальне враження
  // ─────────────────────────────────────────────
  form.addSectionHeaderItem()
    .setTitle('БЛОК 1 — Загальне враження від роботи з офісом');

  form.addMultipleChoiceItem()
    .setTitle('1. Як би ви загалом оцінили роботу офісу вашого філіалу?')
    .setRequired(true)
    .setChoiceValues([
      '⭐⭐⭐⭐⭐ Відмінно — завжди допомагають і вирішують питання',
      '⭐⭐⭐⭐ Добре — переважно задоволений',
      '⭐⭐⭐ Нормально — бувають проблеми але терпимо',
      '⭐⭐ Погано — частіше незадоволений',
      '⭐ Дуже погано — офіс не допомагає'
    ]);

  form.addMultipleChoiceItem()
    .setTitle('2. Як швидко офіс реагує на ваші звернення та проблеми?')
    .setRequired(true)
    .setChoiceValues([
      'Дуже швидко — відповідають одразу або протягом години',
      'Швидко — зазвичай відповідають того ж дня',
      'Повільно — доводиться чекати кілька днів',
      'Дуже повільно або не відповідають зовсім',
      'Не звертався — не виникало потреби'
    ]);

  form.addMultipleChoiceItem()
    .setTitle('3. Чи вирішуються ваші проблеми після звернення до офісу?')
    .setRequired(true)
    .setChoiceValues([
      'Так, завжди або майже завжди',
      'Так, але не з першого разу — доводиться нагадувати',
      'Іноді вирішуються, іноді ні',
      'Рідко вирішуються',
      'Ніколи або майже ніколи'
    ]);

  // ─────────────────────────────────────────────
  // БЛОК 2 — Оцінка співробітників
  // ─────────────────────────────────────────────
  form.addSectionHeaderItem()
    .setTitle('БЛОК 2 — Оцінка кожного співробітника офісу')
    .setHelpText('Оцініть кожного співробітника з яким ви взаємодієте. Якщо не мали контакту — пропустіть.');

  // Керівник філіалу
  form.addSectionHeaderItem()
    .setTitle('КЕРІВНИК ФІЛІАЛУ');

  form.addMultipleChoiceItem()
    .setTitle('4а. Як він/вона реагує на ваші звернення?')
    .setRequired(false)
    .setChoiceValues([
      'Завжди доступний і вирішує питання',
      'Доступний, але не завжди вирішує',
      'Важко дістатися, перенаправляє до інших',
      'Практично недоступний',
      'Не мав контакту з керівником'
    ]);

  form.addMultipleChoiceItem()
    .setTitle('4б. Як би ви описали його/її ставлення до водіїв?')
    .setRequired(false)
    .setChoiceValues([
      'Поважає водіїв, розмовляє по-людськи',
      'Нормальне ставлення, без особливостей',
      'Формальне, байдуже',
      'Зверхнє або неповажне',
      'Важко оцінити'
    ]);

  // Заступник з ефективності
  form.addSectionHeaderItem()
    .setTitle('ЗАСТУПНИК З ЕФЕКТИВНОЇ РОБОТИ ВОДІЇВ');

  form.addMultipleChoiceItem()
    .setTitle('5а. Наскільки він/вона допомагає вам заробляти більше?')
    .setRequired(false)
    .setChoiceValues([
      'Активно допомагає — дає корисні поради та підтримку',
      'Іноді допомагає',
      'Практично не взаємодіємо',
      'Більше контролює ніж допомагає',
      'Не мав контакту'
    ]);

  form.addMultipleChoiceItem()
    .setTitle('5б. Чи відчуваєте ви підтримку з його/її боку коли виникають складнощі на лінії?')
    .setRequired(false)
    .setChoiceValues([
      'Так, завжди підтримує',
      'Іноді підтримує',
      'Рідко',
      'Ні, допомоги немає',
      'Не звертався'
    ]);

  // Рекрутер
  form.addSectionHeaderItem()
    .setTitle('РЕКРУТЕР');

  form.addMultipleChoiceItem()
    .setTitle('6а. Як проходило ваше оформлення на роботу?')
    .setRequired(false)
    .setChoiceValues([
      'Швидко і комфортно, все пояснили',
      'Нормально, але були незрозумілі моменти',
      'Довго і заплутано',
      'Погано — відчував що мені не раді',
      'Не пам\'ятаю деталей'
    ]);

  form.addMultipleChoiceItem()
    .setTitle('6б. Чи отримали ви повну і чесну інформацію про умови роботи до виходу на лінію?')
    .setRequired(false)
    .setChoiceValues([
      'Так, все розповіли чесно і повно',
      'В основному так, але дещо дізнався вже в процесі',
      'Деякі важливі речі приховали або не сказали',
      'Багато що виявилось інакше ніж обіцяли'
    ]);

  // Заступник з технічної частини
  form.addSectionHeaderItem()
    .setTitle('ЗАСТУПНИК З ТЕХНІЧНОЇ ЧАСТИНИ');

  form.addMultipleChoiceItem()
    .setTitle('7а. Як швидко вирішуються технічні проблеми з автомобілем?')
    .setRequired(false)
    .setChoiceValues([
      'Дуже швидко — мінімальний простій',
      'Нормально — в розумні терміни',
      'Повільно — авто стоїть довше ніж потрібно',
      'Дуже повільно, простої затягуються',
      'Рідко маю технічні проблеми'
    ]);

  form.addMultipleChoiceItem()
    .setTitle('7б. Як вас інформують про стан ремонту вашого авто?')
    .setRequired(false)
    .setChoiceValues([
      'Завжди тримають в курсі',
      'Іноді повідомляють, іноді доводиться самому питати',
      'Практично не інформують — доводиться постійно уточнювати',
      'Взагалі не повідомляють'
    ]);

  // ─────────────────────────────────────────────
  // БЛОК 3 — Конкретні ситуації
  // ─────────────────────────────────────────────
  form.addSectionHeaderItem()
    .setTitle('БЛОК 3 — Конкретні ситуації');

  form.addMultipleChoiceItem()
    .setTitle('8. Чи були ситуації коли ви зверталися з проблемою і вас проігнорували або відмовили без пояснень?')
    .setRequired(true)
    .setChoiceValues([
      'Ні, такого не було',
      'Так, один раз',
      'Так, кілька разів',
      'Так, це відбувається регулярно'
    ]);

  form.addMultipleChoiceItem()
    .setTitle('9. Чи є в офісі співробітник до якого найлегше і найприємніше звертатися? (не вказуйте ім\'я — просто роль)')
    .setRequired(false)
    .setChoiceValues([
      'Керівник філіалу',
      'Заступник з ефективності',
      'Рекрутер',
      'Заступник з технічної частини',
      'Всі однаково доступні',
      'Нікому не комфортно звертатися'
    ]);

  form.addCheckboxItem()
    .setTitle('10. Що найбільше вас дратує або засмучує в роботі офісу? (можна обрати кілька)')
    .setRequired(false)
    .setChoiceValues([
      'Повільна реакція на звернення',
      'Обіцянки які не виконуються',
      'Неповажне або байдуже ставлення',
      'Відсутність інформації про стан авто',
      'Складно дозвонитися або написати',
      'Питання вирішуються частково або не вирішуються',
      'Різне ставлення до різних водіїв',
      'Нічого не дратує — все влаштовує'
    ]);

  form.addTextItem()
    .setTitle('11. Якби ви могли змінити одну річ в роботі офісу — що б це було?')
    .setHelpText('Напишіть своїми словами')
    .setRequired(false);

  // ─────────────────────────────────────────────
  // БЛОК 4 — Загальне задоволення
  // ─────────────────────────────────────────────
  form.addSectionHeaderItem()
    .setTitle('БЛОК 4 — Загальне задоволення');

  form.addMultipleChoiceItem()
    .setTitle('12. Чи рекомендували б ви роботу в DriveMe знайомому?')
    .setRequired(true)
    .setChoiceValues([
      'Так, точно рекомендував би',
      'Скоріше так',
      'Не впевнений',
      'Скоріше ні',
      'Ні, не рекомендував би'
    ]);

  form.addTextItem()
    .setTitle('13. Що вам найбільше подобається в роботі з нашим парком?')
    .setRequired(false);

  form.addMultipleChoiceItem()
    .setTitle('14. Ваш філіал (потрібно для аналізу — анонімність зберігається)')
    .setRequired(true)
    .setChoiceValues([
      'Дніпро Поля',
      'Дніпро Тополь',
      'Кривий Ріг',
      'Запоріжжя',
      'Вінниця',
      'Полтава',
      'Львів'
    ]);

  // ─────────────────────────────────────────────
  // Вивести посилання в лог
  // ─────────────────────────────────────────────
  var url = form.getPublishedUrl();
  var editUrl = form.getEditUrl();

  Logger.log('✅ Форма створена!');
  Logger.log('📋 Посилання для водіїв: ' + url);
  Logger.log('✏️  Посилання для редагування: ' + editUrl);

  // Показати у popup
  var ui = SpreadsheetApp.getUi ? SpreadsheetApp.getUi() : null;
  Browser.msgBox(
    '✅ Форма створена!\n\n' +
    '📋 Посилання для водіїв:\n' + url + '\n\n' +
    '(також дивіться у Logs → View logs)'
  );
}
